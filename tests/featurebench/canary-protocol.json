    {
      "order": 4,
      "id": "adapter_prediction_acceptance",
      "operation": "official_featurebench_eval",
      "evaluator_arguments": [
        "--predictions-path",
        "<featurebench_prediction_jsonl>",
        "--dataset",
        "<pinned_dataset_snapshot>",
        "--split",
        "fast",
        "--task-id",
        "mwaskom__seaborn.7001ebe7.test_algorithms.1f0181c2.lv1",
        "--n-concurrent",
        "1",
        "--include-failed"
      ],
      "expected": {
        "evaluation_completed": true,
        "resolved": "record_observed_boolean"
      }
    }
  ],
  "outcome_contract": {
    "agent_completion": {
      "source": "AskMe structured result status",
      "values": [
        true,
        false
      ]
    },
    "feature_acceptance": {
      "source": "Official FeatureBench evaluator resolved field",
      "values": [
        true,
        false
      ]
    },
    "must_report_joint_outcome": true,
    "agent_complete_does_not_imply_acceptance": true,
    "acceptance_does_not_require_agent_complete": true
