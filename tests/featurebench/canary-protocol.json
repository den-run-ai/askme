  "sequence": [
    {
      "order": 1,
      "id": "gold_control",
      "operation": "official_featurebench_eval",
      "predictions": "gold",
      "expected": {
        "evaluation_completed": true,
        "resolved": true
      }
    },
    {
      "order": 2,
      "id": "harmless_nonempty_control",
      "operation": "official_featurebench_eval",
      "prediction": {
        "instance_id": "mwaskom__seaborn.7001ebe7.test_algorithms.1f0181c2.lv1",
        "agent": "harmless-control",
        "model": "none",
        "n_attempt": 1,
        "success": true,
        "model_patch": "diff --git a/ASKME_FEATUREBENCH_CONTROL.txt b/ASKME_FEATUREBENCH_CONTROL.txt\nnew file mode 100644\nindex 0000000..4d6d14c\n--- /dev/null\n+++ b/ASKME_FEATUREBENCH_CONTROL.txt\n@@ -0,0 +1 @@\n+adapter qualification control\n",
        "model_patch_kind": "add_file_only",
        "path": "ASKME_FEATUREBENCH_CONTROL.txt",
        "content": "adapter qualification control\n",
        "must_be_nonempty": true
      },
      "evaluator_arguments": [
        "--include-failed"
      ],
      "expected": {
        "evaluation_completed": true,
        "patch_applied": true,
        "resolved": false
      }
    },
    {
      "order": 3,
      "id": "askme_adapter_run",
      "operation": "cold_start_agent_inference",
      "emit_prediction_even_if_agent_incomplete": true,
      "expected_artifacts": [
